<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ui="UnityEngine.UIElements"
    xmlns:uie="UnityEditor.UIElements"
    xsi:noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd"
>
    <ui:Style src="../Example.uss" />
    <ui:VisualElement name="confirmation" class="screen-fill popup-backdrop">
        <ui:VisualElement class="panel">
            <ui:Label text="Start a new game?" class="message-label" />
            <ui:VisualElement class="button-row">
                <ui:Button name="yes-button" text="Yes" class="button-left" />
                <ui:Button name="no-button" text="No" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
