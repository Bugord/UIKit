<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ui="UnityEngine.UIElements"
    xmlns:uie="UnityEditor.UIElements"
    xsi:noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd"
>
    <ui:Style src="../Example.uss" />
    <ui:VisualElement name="settings" class="screen-fill">
        <ui:VisualElement class="panel">
            <ui:Label text="Settings" class="title" />
            <ui:Slider name="volume-slider" label="Volume" low-value="0" high-value="1" />
            <ui:Toggle name="muted-toggle" label="Muted" />
            <ui:Button name="back-button" text="Back" class="menu-button" style="margin-top: 16px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
