<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ui="UnityEngine.UIElements"
    xmlns:uie="UnityEditor.UIElements"
    xsi:noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd"
>
    <ui:Style src="../Example.uss" />
    <ui:VisualElement name="player-badge" class="badge">
        <ui:Label name="level-label" text="Level 1" />
        <ui:Label name="score-label" text="Score: 0" />
        <ui:Button name="add-score-button" text="+10" class="badge-button" />
    </ui:VisualElement>
</ui:UXML>
